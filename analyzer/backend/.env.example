GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
NOTION_TOKEN=
NOTION_DATABASE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Meaningly_bot
SITE_BASE_URL=https://maxtristen.com
DOWNLOADER_URL=http://127.0.0.1:8003

# Comma-separated lowercase wallet addresses allowed into /analyzer/. Empty = nobody gets in.
ANALYZER_ALLOWED_WALLETS=

# Prod only — leave unset locally to use analyzer/backend/.local-data/
ANALYZER_DB_PATH=/opt/maxtristen-data/analyzer/analyzer.db
ANALYZER_FILES_DIR=/opt/maxtristen-data/analyzer/files
