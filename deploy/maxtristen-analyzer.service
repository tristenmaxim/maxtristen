[Unit]
Description=maxtristen: analyzer (Gemini video transcriber)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/maxtristen/analyzer/backend
ExecStart=/opt/maxtristen/analyzer/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8004
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
