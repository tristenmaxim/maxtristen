[Unit]
Description=maxtristen: blog (posts, MetaMask-gated writes)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/maxtristen/blog/backend
ExecStart=/opt/maxtristen/blog/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8005
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
