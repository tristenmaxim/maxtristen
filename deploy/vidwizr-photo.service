[Unit]
Description=vidwizr-service: photo (ecom image enhancer)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/vidwizr-service/photo/backend
ExecStart=/opt/vidwizr-service/photo/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
